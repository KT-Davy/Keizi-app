const { createClient } = require('@supabase/supabase-js');

const supabaseAdmin = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
);

const CORS_HEADERS = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'Content-Type, Authorization',
  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS'
};

exports.handler = async (event) => {
  if (event.httpMethod === 'OPTIONS') {
    return { statusCode: 200, headers: CORS_HEADERS, body: '' };
  }

  const caller = await getCaller(event);
  if (!caller) {
    return json(401, { error: 'Connexion requise' });
  }

  if (event.httpMethod === 'GET') {
    const { data, error } = await supabaseAdmin
      .from('app_state')
      .select('data')
      .eq('id', 1)
      .single();
    if (error) return json(500, { error: error.message });
    return json(200, {
      state: data.data,
      you: { name: caller.full_name, isAdmin: caller.is_admin }
    });
  }

  if (event.httpMethod === 'POST') {
    if (!caller.is_admin) {
      return json(403, { error: 'Seuls KOALA Davy et SOMDA Eddy peuvent modifier les données' });
    }

    let body;
    try {
      body = JSON.parse(event.body || '{}');
    } catch (e) {
      return json(400, { error: 'JSON invalide' });
    }
    const newState = body.state;
    if (!newState || !Array.isArray(newState.members)) {
      return json(400, { error: 'État invalide' });
    }

    const { data: oldRow } = await supabaseAdmin
      .from('app_state')
      .select('data')
      .eq('id', 1)
      .single();
    const oldState = oldRow ? oldRow.data : null;

    const { error: upErr } = await supabaseAdmin
      .from('app_state')
      .update({ data: newState, updated_at: new Date().toISOString(), updated_by: caller.full_name })
      .eq('id', 1);
    if (upErr) return json(500, { error: upErr.message });

    try {
      await sendCreditEmails(oldState, newState);
    } catch (e) {
      console.error('Erreur envoi email automatique :', e);
    }

    return json(200, { ok: true });
  }

  return json(405, { error: 'Méthode non autorisée' });
};

async function getCaller(event) {
  const authHeader = event.headers.authorization || event.headers.Authorization;
  if (!authHeader) return null;
  const token = authHeader.replace('Bearer ', '');
  const { data, error } = await supabaseAdmin.auth.getUser(token);
  if (error || !data.user) return null;
  const { data: profile } = await supabaseAdmin
    .from('profiles')
    .select('full_name, is_admin')
    .eq('id', data.user.id)
    .single();
  if (!profile) return null;
  return { ...profile, email: data.user.email };
}

function json(statusCode, obj) {
  return {
    statusCode,
    headers: { ...CORS_HEADERS, 'Content-Type': 'application/json' },
    body: JSON.stringify(obj)
  };
}

async function sendCreditEmails(oldState, newState) {
  if (!oldState || !Array.isArray(oldState.members)) return;
  const oldById = Object.fromEntries(oldState.members.map((m) => [m.id, m]));
  const maxCredits = newState.settings?.maxCredits ?? 5;
  const orgName = newState.settings?.orgName || 'Keizi';

  for (const m of newState.members) {
    const before = oldById[m.id];
    if (!before) continue;

    if (m.credits < before.credits && m.credits > 0 && m.credits <= 2 && m.email) {
      await sendEmail(
        m.email,
        `⚠️ Alerte crédits ${orgName} — ${m.credits}/${maxCredits}`,
        `<p>Bonjour ${escapeHtml(m.name)},</p>
         <p>Ton solde de crédits ${escapeHtml(orgName)} est descendu à <b>${m.credits}/${maxCredits}</b>.</p>
         <p>Si tes crédits venaient à atteindre 0, ton dossier serait automatiquement transmis au conseil de discipline. Merci de redresser la situation rapidement.</p>
         <p>— ${escapeHtml(orgName)}</p>`
      );
    }

    if (m.credits === 0 && before.credits > 0) {
      const team = (newState.settings?.keiziTeamEmails || []).map((t) => t.email).filter(Boolean);
      for (const addr of team) {
        await sendEmail(
          addr,
          `🚨 Conseil de discipline requis — ${m.name}`,
          `<p>${escapeHtml(m.name)} vient d'épuiser la totalité de ses ${maxCredits} crédits ${escapeHtml(orgName)}.</p>
           <p>Conformément au règlement, son dossier doit être examiné en conseil de discipline.</p>
           <p>— ${escapeHtml(orgName)}</p>`
        );
      }
    }
  }
}

async function sendEmail(to, subject, html) {
  await fetch('https://api.resend.com/emails', {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${process.env.RESEND_API_KEY}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ from: process.env.RESEND_FROM, to, subject, html })
  });
}

function escapeHtml(s) {
  return (s || '').toString().replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
}
